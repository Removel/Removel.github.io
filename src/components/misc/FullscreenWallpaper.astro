---
import { siteConfig } from "../../config";
import type { FullscreenWallpaperConfig } from "../../types/config";

interface Props {
	config: FullscreenWallpaperConfig;
	className?: string;
}

const { config, className } = Astro.props;

// 获取当前设备类型的图片源
const getImageSources = async () => {
	const srcConfig = config.src;

	// API 图片逻辑
	if (siteConfig.banner.imageApi?.enable && siteConfig.banner.imageApi?.url) {
		try {
			const response = await fetch(siteConfig.banner.imageApi.url);
			const text = await response.text();
			const apiImages = text.split("\n").filter((line) => line.trim());
			if (apiImages.length > 0) {
				return { desktop: apiImages, mobile: apiImages };
			}
		} catch (error) {
			console.warn("Failed to fetch images from API:", error);
		}
	}

	const toArray = (src: string | string[] | undefined): string[] => 
		Array.isArray(src) ? src : (typeof src === "string" ? [src] : []);

	if (typeof srcConfig === "object" && srcConfig !== null && !Array.isArray(srcConfig)) {
		const desktop = toArray(srcConfig.desktop);
		const mobile = toArray(srcConfig.mobile);
		return {
			desktop: desktop.length > 0 ? desktop : mobile,
			mobile: mobile.length > 0 ? mobile : desktop,
		};
	}

	// 如果是字符串或字符串数组，同时用于桌面端和移动端
	const allImages = toArray(srcConfig as string | string[]);
	return { desktop: allImages, mobile: allImages };
};

const imageSources = await getImageSources();
const hasDesktopImages = imageSources.desktop.length > 0;
const hasMobileImages = imageSources.mobile.length > 0;

if (!hasDesktopImages && !hasMobileImages) {return null;}

const getPreviewPath = (src: string, type: "desktop" | "mobile") => {
	if (!src.startsWith(`/assets/${type}-banner/`)) {
		return src;
	}

	const fileName = src.split("/").pop() || "";
	const baseName = fileName.replace(/\.[^.]+$/, "");
	return `/generated/image-previews/wallpapers/${type}-banner/${baseName}-preview.webp`;
};

const desktopImages = imageSources.desktop.map((src) => ({
	src: getPreviewPath(src, "desktop"),
	fallback: src,
}));
const mobileImages = imageSources.mobile.map((src) => ({
	src: getPreviewPath(src, "mobile"),
	fallback: src,
}));

const carouselEnabled = config.carousel?.enable ?? false;
const carouselIntervalMs = Math.max(
	(config.carousel?.interval || 5) * 1000,
	1500,
);
const position = config.position || "center";
const zIndex = config.zIndex || -1;
const opacity = config.opacity || 0.8;
const blurAmount = config.blur || 0;
---

<div 
	class:list={[
		"fixed inset-0 w-full h-full overflow-hidden pointer-events-none",
		className
	]}
	style={`z-index: ${zIndex}; opacity: ${opacity}; transform: translateZ(0); perspective: 1000px;`}
	data-fullscreen-wallpaper
></div>

<script
	is:inline
	define:vars={{
		desktopImages,
		mobileImages,
		carouselEnabled,
		carouselIntervalMs,
		position,
		blurAmount,
		defaultWallpaperMode: siteConfig.wallpaperMode.defaultMode,
	}}
>
	(function setupFullscreenWallpaper() {
		if (window.__wallpaper_cleanup) {
			window.__wallpaper_cleanup();
		}

		const container = document.querySelector("[data-fullscreen-wallpaper]");
		if (!container) {
			return;
		}

		let timer = null;
		let currentImage = null;
		let nextImage = null;
		let currentIndex = 0;
		let activeImages = [];
		const mediaQuery = window.matchMedia("(min-width: 768px)");

		function getMode() {
			return localStorage.getItem("wallpaperMode") || defaultWallpaperMode;
		}

		function createImage(image, isCurrent) {
			const element = document.createElement("img");
			element.src = image.src;
			element.dataset.originalSrc = image.fallback;
			element.alt = "";
			element.setAttribute("aria-hidden", "true");
			element.decoding = "async";
			element.loading = isCurrent ? "eager" : "lazy";
			if (isCurrent) {
				element.fetchPriority = "high";
			}
			element.className =
				"absolute inset-0 w-full h-full object-cover transition-opacity duration-1000";
			element.style.objectPosition = position;
			element.style.opacity = isCurrent ? "1" : "0";
			element.style.transform = "translateZ(0)";
			element.style.backfaceVisibility = "hidden";
			element.style.willChange = "opacity";
			if (blurAmount > 0) {
				element.style.filter = "blur(" + blurAmount + "px)";
			}
			element.addEventListener(
				"error",
				function () {
					if (
						element.dataset.originalSrc &&
						element.src !== new URL(element.dataset.originalSrc, location.href).href
					) {
						element.src = element.dataset.originalSrc;
					}
				},
				{ once: true },
			);
			return element;
		}

		function stop() {
			if (timer !== null) {
				clearInterval(timer);
				timer = null;
			}
		}

		function clearImages() {
			stop();
			currentImage = null;
			nextImage = null;
			container.replaceChildren();
		}

		function prepareNext() {
			if (
				nextImage ||
				!carouselEnabled ||
				activeImages.length <= 1 ||
				navigator.connection?.saveData
			) {
				return;
			}

			const nextIndex = (currentIndex + 1) % activeImages.length;
			nextImage = createImage(activeImages[nextIndex], false);
			container.appendChild(nextImage);
		}

		function switchImage() {
			if (!nextImage) {
				const nextIndex = (currentIndex + 1) % activeImages.length;
				nextImage = createImage(activeImages[nextIndex], false);
				container.appendChild(nextImage);
			}

			const outgoingImage = currentImage;
			const incomingImage = nextImage;
			currentIndex = (currentIndex + 1) % activeImages.length;
			sessionStorage.setItem(
				"mizuki_wallpaper_index",
				String(currentIndex),
			);
			nextImage = null;

			incomingImage.style.opacity = "1";
			if (outgoingImage) {
				outgoingImage.style.opacity = "0";
			}

			window.setTimeout(function () {
				if (outgoingImage?.parentNode) {
					outgoingImage.remove();
				}
				currentImage = incomingImage;
				prepareNext();
			}, 1050);
		}

		function start() {
			stop();
			if (!carouselEnabled || activeImages.length <= 1 || document.hidden) {
				return;
			}
			timer = window.setInterval(switchImage, carouselIntervalMs);
		}

		function initialize() {
			clearImages();
			if (getMode() !== "fullscreen") {
				container.style.display = "none";
				return;
			}

			container.style.display = "block";
			activeImages = mediaQuery.matches ? desktopImages : mobileImages;
			if (!activeImages.length) {
				return;
			}

			const savedIndex = parseInt(
				sessionStorage.getItem("mizuki_wallpaper_index") || "0",
				10,
			);
			currentIndex =
				savedIndex >= 0 && savedIndex < activeImages.length
					? savedIndex
					: 0;
			currentImage = createImage(activeImages[currentIndex], true);
			container.appendChild(currentImage);
			currentImage.addEventListener("load", prepareNext, { once: true });
			if (currentImage.complete) {
				prepareNext();
			}
			start();
		}

		function handleModeChange() {
			initialize();
		}

		function handleVisibilityChange() {
			if (document.hidden) {
				stop();
			} else if (getMode() === "fullscreen") {
				start();
			}
		}

		window.addEventListener("wallpaper-mode-change", handleModeChange);
		document.addEventListener("visibilitychange", handleVisibilityChange);
		mediaQuery.addEventListener("change", initialize);

		window.__wallpaper_cleanup = function () {
			clearImages();
			window.removeEventListener(
				"wallpaper-mode-change",
				handleModeChange,
			);
			document.removeEventListener(
				"visibilitychange",
				handleVisibilityChange,
			);
			mediaQuery.removeEventListener("change", initialize);
		};

		initialize();
	})();
</script>
