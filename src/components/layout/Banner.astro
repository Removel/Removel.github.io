---
/**
 * Banner 组件
 * 支持单图模式和轮播图模式，包含文字覆盖层和水波纹效果
 * 轮播模式使用 Ken Burns + Crossfade 动画（参考 Firefly 实现）
 */

import TypewriterText from "@components/atoms/typewriter-text/TypewriterText.astro";
import { Icon } from "astro-icon/components";
import { siteConfig } from "../../config";
import { BANNER_HEIGHT_EXTEND } from "../../constants/constants";

interface Props {
	// Banner 配置
	bannerImages: {
		desktop: string | string[];
		mobile: string | string[];
	};

	// 响应式
	mobileNonHomeBannerClass?: string;

	// 文字覆盖层
	showTextOverlay?: boolean;
	overlayTitle?: string;
	overlaySubtitle?: string | string[];
	typewriter?: boolean;

	// 水波纹效果
	showWave?: boolean;
}

const {
	bannerImages,
	mobileNonHomeBannerClass = "",
	showTextOverlay = false,
	overlayTitle = siteConfig.banner.homeText?.title,
	overlaySubtitle = siteConfig.banner.homeText?.subtitle,
	typewriter = siteConfig.banner.homeText?.typewriter?.enable ?? false,
	showWave = siteConfig.banner.waves?.enable ?? true,
} = Astro.props;

// 标准化图片数组
const normalizeToArray = (images: string | string[]): string[] =>
	Array.isArray(images) ? images : [images];

const desktopImages = normalizeToArray(bannerImages.desktop).filter(Boolean);
const mobileImages = normalizeToArray(bannerImages.mobile).filter(Boolean);

const getPreviewPath = (src: string, type: "desktop" | "mobile") => {
	if (!src.startsWith(`/assets/${type}-banner/`)) {
		return src;
	}

	const fileName = src.split("/").pop() || "";
	const baseName = fileName.replace(/\.[^.]+$/, "");
	return `/generated/image-previews/wallpapers/${type}-banner/${baseName}-preview.webp`;
};

const desktopPreviewImages = desktopImages.map((src) => ({
	src: getPreviewPath(src, "desktop"),
	fallback: src,
}));
const mobilePreviewImages = mobileImages.map((src) => ({
	src: getPreviewPath(src, "mobile"),
	fallback: src,
}));

const carouselEnabled = siteConfig.banner.carousel?.enable ?? false;
const carouselIntervalMs = Math.max(
	(siteConfig.banner.carousel?.interval || 6) * 1000,
	1500,
);
const fadeMs = Math.min(
	Math.max(Math.round(carouselIntervalMs * 0.4), 500),
	1500,
);
const kbDurationMs = carouselIntervalMs + fadeMs;

const hasBannerCredit = siteConfig.banner.credit.enable;
const hasBannerLink = !!siteConfig.banner.credit.url;
---

<div
	id="banner-wrapper"
	class={`absolute z-10 w-full transition duration-700 overflow-hidden ${mobileNonHomeBannerClass}`}
	style={`top: -${BANNER_HEIGHT_EXTEND}vh`}
>
	<div id="banner-carousel" class="relative h-full w-full overflow-hidden">
		<div id="banner" class="absolute inset-0 h-full w-full overflow-hidden">
		</div>
	</div>

	<!-- Ken Burns 动画样式（放在 body 中，不受 Swup head 替换影响） -->
	{carouselEnabled && (
		<Fragment set:html={`<style>
			@keyframes bannerKenBurns {
				0% { transform: scale(1.03); }
				100% { transform: scale(1.13); }
			}
			.banner-kb {
				animation: bannerKenBurns ${kbDurationMs}ms ease-out forwards;
			}
		</style>`} />
	)}

	<script
		is:inline
		data-swup-ignore-script
		define:vars={{
			desktopImages: desktopPreviewImages,
			mobileImages: mobilePreviewImages,
			carouselEnabled,
			carouselIntervalMs,
			fadeMs,
			position: siteConfig.banner.position,
			defaultWallpaperMode: siteConfig.wallpaperMode.defaultMode,
		}}
	>
		(function setupBannerCarousel() {
			if (window.__bannerCarouselCleanup) {
				window.__bannerCarouselCleanup();
			}

			const container = document.getElementById("banner");
			const interactionArea = document.getElementById("banner-carousel");
			if (!container || !interactionArea) {
				return;
			}

			let timer = null;
			let currentImage = null;
			let nextImage = null;
			let currentIndex = 0;
			let activeImages = [];
			let paused = false;
			let switching = false;
			let touchStartX = 0;
			let touchStartY = 0;
			const mediaQuery = window.matchMedia("(min-width: 768px)");

			function getMode() {
				return localStorage.getItem("wallpaperMode") || defaultWallpaperMode;
			}

			function createImage(image, isCurrent) {
				const element = document.createElement("img");
				element.src = image.src;
				element.dataset.originalSrc = image.fallback;
				element.alt = "";
				element.setAttribute("aria-hidden", "true");
				element.decoding = "async";
				element.loading = isCurrent ? "eager" : "lazy";
				if (isCurrent) {
					element.fetchPriority = "high";
				}
				element.className =
					"absolute inset-0 h-full w-full object-cover transition-opacity banner-kb";
				element.style.objectPosition = position;
				element.style.opacity = isCurrent ? "1" : "0";
				element.style.transitionDuration = fadeMs + "ms";
				element.addEventListener(
					"error",
					function () {
						if (
							element.dataset.originalSrc &&
							element.src !==
								new URL(element.dataset.originalSrc, location.href).href
						) {
							element.src = element.dataset.originalSrc;
						}
					},
					{ once: true },
				);
				return element;
			}

			function stop() {
				if (timer !== null) {
					clearInterval(timer);
					timer = null;
				}
			}

			function clearImages() {
				stop();
				currentImage = null;
				nextImage = null;
				switching = false;
				container.replaceChildren();
			}

			function prepareNext() {
				if (
					nextImage ||
					!carouselEnabled ||
					activeImages.length <= 1 ||
					navigator.connection?.saveData
				) {
					return;
				}

				const nextIndex = (currentIndex + 1) % activeImages.length;
				nextImage = createImage(activeImages[nextIndex], false);
				container.appendChild(nextImage);
			}

			function switchTo(targetIndex) {
				if (switching || activeImages.length <= 1) {
					return;
				}
				switching = true;
				stop();

				const normalizedIndex =
					(targetIndex + activeImages.length) % activeImages.length;
				const preparedImage = nextImage;
				const incomingImage =
					normalizedIndex === (currentIndex + 1) % activeImages.length &&
					preparedImage
						? preparedImage
						: createImage(activeImages[normalizedIndex], false);
				if (preparedImage && incomingImage !== preparedImage) {
					preparedImage.remove();
				}
				if (!incomingImage.parentNode) {
					container.appendChild(incomingImage);
				}

				const outgoingImage = currentImage;
				currentIndex = normalizedIndex;
				sessionStorage.setItem(
					mediaQuery.matches ? "banner_desktop_index" : "banner_mobile_index",
					String(currentIndex),
				);
				nextImage = null;

				requestAnimationFrame(function () {
					incomingImage.style.opacity = "1";
					if (outgoingImage) {
						outgoingImage.style.opacity = "0";
					}
				});

				window.setTimeout(function () {
					if (outgoingImage?.parentNode) {
						outgoingImage.remove();
					}
					currentImage = incomingImage;
					switching = false;
					prepareNext();
					start();
				}, fadeMs + 50);
			}

			function start() {
				stop();
				if (
					paused ||
					document.hidden ||
					getMode() !== "banner" ||
					!carouselEnabled ||
					activeImages.length <= 1
				) {
					return;
				}
				timer = window.setInterval(function () {
					switchTo(currentIndex + 1);
				}, carouselIntervalMs);
			}

			function initialize() {
				clearImages();
				if (getMode() !== "banner") {
					return;
				}

				activeImages = mediaQuery.matches ? desktopImages : mobileImages;
				if (!activeImages.length) {
					return;
				}

				const storageKey = mediaQuery.matches
					? "banner_desktop_index"
					: "banner_mobile_index";
				const savedIndex = parseInt(
					sessionStorage.getItem(storageKey) ||
						String(Math.floor(Math.random() * activeImages.length)),
					10,
				);
				currentIndex =
					savedIndex >= 0 && savedIndex < activeImages.length
						? savedIndex
						: 0;
				currentImage = createImage(activeImages[currentIndex], true);
				container.appendChild(currentImage);
				currentImage.addEventListener("load", prepareNext, { once: true });
				if (currentImage.complete) {
					prepareNext();
				}
				start();
			}

			function handleVisibilityChange() {
				if (document.hidden) {
					stop();
				} else {
					start();
				}
			}

			function handleMouseEnter() {
				paused = true;
				stop();
			}

			function handleMouseLeave() {
				paused = false;
				start();
			}

			function handleTouchStart(event) {
				touchStartX = event.touches[0].clientX;
				touchStartY = event.touches[0].clientY;
				paused = true;
				stop();
			}

			function handleTouchEnd(event) {
				const deltaX = touchStartX - event.changedTouches[0].clientX;
				const deltaY = touchStartY - event.changedTouches[0].clientY;
				if (Math.abs(deltaX) > 50 && Math.abs(deltaX) > Math.abs(deltaY)) {
					switchTo(currentIndex + (deltaX > 0 ? 1 : -1));
				}
				touchStartX = 0;
				touchStartY = 0;
				paused = false;
				start();
			}

			window.addEventListener("wallpaper-mode-change", initialize);
			document.addEventListener("visibilitychange", handleVisibilityChange);
			interactionArea.addEventListener("mouseenter", handleMouseEnter);
			interactionArea.addEventListener("mouseleave", handleMouseLeave);
			interactionArea.addEventListener("touchstart", handleTouchStart, {
				passive: true,
			});
			interactionArea.addEventListener("touchend", handleTouchEnd, {
				passive: true,
			});
			mediaQuery.addEventListener("change", initialize);

			window.__bannerCarouselCleanup = function () {
				clearImages();
				window.removeEventListener("wallpaper-mode-change", initialize);
				document.removeEventListener(
					"visibilitychange",
					handleVisibilityChange,
				);
				interactionArea.removeEventListener("mouseenter", handleMouseEnter);
				interactionArea.removeEventListener("mouseleave", handleMouseLeave);
				interactionArea.removeEventListener("touchstart", handleTouchStart);
				interactionArea.removeEventListener("touchend", handleTouchEnd);
				mediaQuery.removeEventListener("change", initialize);
			};

			initialize();
		})();
	</script>

	<!-- 首页文字覆盖层 -->
	{siteConfig.banner.homeText?.enable && (
		<div class={`banner-text-overlay absolute inset-0 z-20 flex items-center justify-center ${!showTextOverlay ? "hidden" : ""}`}>
			<div class="w-4/5 lg:w-3/4 text-center mb-0">
				<div class="flex flex-col">
					{overlayTitle && (
						<h1 class="banner-title text-6xl lg:text-8xl text-white drop-shadow-lg mb-2 lg:mb-4">
							{overlayTitle}
						</h1>
					)}
					{overlaySubtitle && (
						<h2 class="banner-subtitle text-xl lg:text-3xl text-white/90 drop-shadow-md">
							<span class="inline-block min-h-[1.2em]">
								{typewriter && Array.isArray(overlaySubtitle) ? (
									<TypewriterText
										text={overlaySubtitle}
										speed={siteConfig.banner.homeText?.typewriter?.speed}
										deleteSpeed={siteConfig.banner.homeText?.typewriter?.deleteSpeed}
										pauseTime={siteConfig.banner.homeText?.typewriter?.pauseTime}
									/>
								) : Array.isArray(overlaySubtitle) ? (
									overlaySubtitle[0]
								) : (
									overlaySubtitle
								)}
							</span>
						</h2>
					)}
				</div>
			</div>
		</div>
	)}

	<!-- 水波纹效果 -->
	{showWave && (
		<div
			class="waves absolute -bottom-[1px] h-[10vh] max-h-[9.375rem] min-h-[3.125rem] w-full md:h-[15vh]"
			id="header-waves"
			style="transform: translateZ(0); will-change: fill;"
		>
			<svg
				class="waves"
				xmlns="http://www.w3.org/2000/svg"
				xmlns:xlink="http://www.w3.org/1999/xlink"
				viewBox="0 20 150 32"
				preserveAspectRatio="none"
				shape-rendering="auto"
				style="transform: translateZ(0); backface-visibility: hidden;"
			>
				<defs>
					<path
						id="gentle-wave"
						d="M-160 44c30 0 58-18 88-18s 58 18 88 18 58-18 88-18 58 18 88 18 v48h-352z"
					>
					</path>
				</defs>
				<g class="parallax" style="transform: translateZ(0);">
					<use
						xlink:href="#gentle-wave"
						x="48"
						y="0"
						class="opacity-25 fill-[var(--page-bg)]"
						style="animation-delay: -2s; animation-duration: 7s; will-change: transform;"
					></use>
					<use
						xlink:href="#gentle-wave"
						x="48"
						y="3"
						class="opacity-50 fill-[var(--page-bg)]"
						style="animation-delay: -3s; animation-duration: 10s; will-change: transform;"
					></use>
					<use
						xlink:href="#gentle-wave"
						x="48"
						y="5"
						class="opacity-75 fill-[var(--page-bg)]"
						style="animation-delay: -4s; animation-duration: 13s; will-change: transform;"
					></use>
					<use
						xlink:href="#gentle-wave"
						x="48"
						y="7"
						class="fill-[var(--page-bg)]"
						style="animation-delay: -5s; animation-duration: 20s; will-change: transform;"
					></use>
				</g>
			</svg>
		</div>
	)}

	<!-- Banner 图片来源标注 -->
	{hasBannerCredit && (
		<a
			href={siteConfig.banner.credit.url}
			id="banner-credit"
			target="_blank"
			rel="noopener"
			aria-label="Visit image source"
			class:list={[
				"group onload-animation transition-all absolute flex justify-center items-center rounded-full px-3 right-4 -top-[3.25rem] bg-black/60 hover:bg-black/70 h-9",
				{ "hover:pr-9 active:bg-black/80": hasBannerLink },
			]}
		>
			<Icon
				class="text-white/75 text-[1.25rem] mr-1"
				name="material-symbols:copyright-outline-rounded"
			/>
			<div class="text-white/75 text-xs">{siteConfig.banner.credit.text}</div>
			<Icon
				class:list={[
					"transition absolute text-[oklch(0.75_0.14_var(--hue))] right-4 text-[0.75rem] opacity-0",
					{ "group-hover:opacity-100": hasBannerLink },
				]}
				name="fa7-solid:arrow-up-right-from-square"
			>
			</Icon>
		</a>
	)}
</div>

<style>
	/* Banner 文本样式 */
	.banner-title {
		text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.7);
		animation: fadeInUp 1s ease-out;
		font-weight: bold;
	}

	.banner-subtitle {
		text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.6);
		animation: fadeInUp 1s ease-out 0.3s both;
		min-height: 1.5em;
		line-height: 1.2;
	}

	@keyframes fadeInUp {
		from {
			opacity: 0;
			transform: translateY(30px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}
</style>
